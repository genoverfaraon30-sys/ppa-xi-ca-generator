{
  "name": "Certificate",
  "type": "object",
  "properties": {
    "document_code": {
      "type": "string",
      "default": "ADM-FOR-012"
    },
    "person_name": {
      "type": "string"
    },
    "person_position": {
      "type": "string"
    },
    "office": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "date_from": {
      "type": "string",
      "format": "date"
    },
    "date_to": {
      "type": "string",
      "format": "date"
    },
    "date_of_appearance": {
      "type": "string",
      "format": "date"
    },
    "purpose": {
      "type": "string"
    },
    "date_of_issuance": {
      "type": "string",
      "format": "date"
    },
    "place_of_issuance": {
      "type": "string",
      "default": "Davao City"
    },
    "signatory_name": {
      "type": "string"
    },
    "signatory_position": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Issued",
        "Voided"
      ],
      "default": "Draft"
    }
  },
  "required": [
    "document_code",
    "person_name",
    "office",
    "location",
    "date_from",
    "purpose",
    "date_of_issuance",
    "place_of_issuance",
    "signatory_name",
    "signatory_position",
    "status"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}